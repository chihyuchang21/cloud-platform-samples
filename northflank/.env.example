# 這些變數在 Northflank 是由 service 的 Environment / Secret group 提供，不會自動注入。
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

APP_ENV=local
APP_SERVICE_NAME=local-dev

# 由 Dockerfile build arg 帶入（Northflank build 可設定 build arguments）。
GIT_COMMIT=0000000

# 收到 SIGTERM 後，readiness 轉 false 再等幾秒才真正關閉，讓流量先被移走。
DRAIN_SECONDS=5
